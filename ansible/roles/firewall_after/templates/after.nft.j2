
table bridge {{ table_name | default('ipv6_fhs') }} {

    chain forward {
        type filter hook forward priority filter; policy accept;

        # Source validation on dedicated attacker port
        iifname "{{ attacker_iface }}" ip6 saddr != fe80::/10 counter drop comment "SOURCE_GUARD_ATTACKER_PORT"

        # Block ND injection from attacker port
        iifname "{{ attacker_iface }}" icmpv6 type { nd-router-solicit, nd-neighbor-solicit, nd-neighbor-advert } counter drop comment "ND_GUARD_ATTACKER_PORT"

        # RA Guard
        iifname != "{{ trusted_router_iface }}" icmpv6 type nd-router-advert counter drop comment "RA_GUARD"

        # DHCPv6 Guard
        iifname != "{{ trusted_dhcp6_iface }}" udp sport 547 counter drop comment "DHCPV6_GUARD"

        # Rate-limit NS from legitimate client ports
        iifname { "{{ client_a_iface }}", "{{ client_b_iface }}" } icmpv6 type nd-neighbor-solicit limit rate over 100/second burst 200 packets counter drop comment "ND_NS_RATE_LIMIT"

        # Rate-limit NA from legitimate client ports
        iifname { "{{ client_a_iface }}", "{{ client_b_iface }}" } icmpv6 type nd-neighbor-advert limit rate over 100/second burst 200 packets counter drop comment "ND_NA_RATE_LIMIT"
    }
}
